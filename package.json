{
  "name": "codium-runner",
  "displayName": "Codium Runner",
  "author": {
    "name": "AF"
  },

  "repository": {
    "type": "git",
    "url": "https://github.com/AFgit1/Runner_git/tree/main"
  },

  "description": "runs code in terminal with customizable commands",
  "version": "1.2.6",
  "engines": {
    "vscode": "^1.50.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "media/logo.png",
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "runner.runCode",
        "title": "Run Code"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "runner.runCode",
          "when": "*",
          "group": "navigation",
          "title": "$(play) Play"
        }
      ]
    }
  },

  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.50.0",
    "@types/mocha": "^10.0.8",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "eslint": "^9.11.1",
    "typescript": "^5.6.2",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1"
  }
}
